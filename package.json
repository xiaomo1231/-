{
  "name": "groovelab",
  "private": true,
  "version": "0.32.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/copy-alphatab.mjs && node scripts/copy-ort.mjs",
    "app": "node scripts/build-electron.mjs && electron .",
    "package": "npm run build && node scripts/build-electron.mjs && node scripts/package-app.mjs",
    "build:web": "vite build --config vite.web.config.ts",
    "build:server": "npm run build:web && node scripts/build-server.mjs",
    "server": "node server-dist/server.mjs",
    "export:web": "node scripts/export-web.mjs",
    "install:local": "node scripts/install-local.mjs"
  },
  "dependencies": {
    "@breezystack/lamejs": "1.2.7",
    "@coderline/alphatab": "1.8.4",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@xyflow/react": "^12.12.0",
    "audify": "^1.10.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dexie": "^4.0.8",
    "lucide-react": "^0.460.0",
    "onnxruntime-node": "^1.30.0",
    "onnxruntime-web": "1.30.0",
    "opencc-js": "1.4.2",
    "pinyin-pro": "3.29.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^2.5.4",
    "tonal": "^6.4.0",
    "tone": "^15.0.4",
    "vexflow": "^4.2.5",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@magenta/music": "^1.23.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.12.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  },
  "main": "electron-dist/main.cjs"
}
